[org.gnome.shell.extensions.dash-to-dock]
animate-appicon-hover=true
animate-appicon-hover-animation-extent={'RIPPLE': 4, 'PLANK': 4, 'SIMPLE': 1}
animate-appicon-hover-animation-travel={'SIMPLE': 0.050000000000000003, 'RIPPLE': 0.40000000000000002, 'PLANK': 0.0}
animate-appicon-hover-animation-zoom={'SIMPLE': 1.0, 'RIPPLE': 1.25, 'PLANK': 2.0}
appicon-margin=0
appicon-padding=8
dot-position='BOTTOM'
dot-size=3
dot-style-focused='DASHES'
dot-style-unfocused='DOTS'
extension-version=9999
focus-highlight=false
global-border-radius=0
highlight-appicon-hover=false
hotkeys-overlay-combo='TEMPORARILY'
panel-anchors='{"unknown-unknown":"MIDDLE"}'
panel-element-positions='{"unknown-unknown":[{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}]}'
panel-lengths='{"unknown-unknown":100}'
panel-positions='{"unknown-unknown":"BOTTOM"}'
panel-sizes='{}'
prefs-opened=true
primary-monitor='unknown-unknown'
show-apps-icon-file=''
show-apps-icon-side-padding=0
stockgs-force-hotcorner=true
stockgs-keep-dash=false
stockgs-keep-top-panel=false
taskbar-locked=true
trans-bg-color='#000000'
trans-dynamic-anim-target=1.0
trans-dynamic-behavior='MAXIMIZED_WINDOWS'
trans-dynamic-distance=1
trans-gradient-bottom-opacity=0.5
trans-gradient-top-color='#000000'
trans-panel-opacity=0.29999999999999999
trans-use-custom-bg=true
trans-use-custom-gradient=false
trans-use-custom-opacity=true
trans-use-dynamic-opacity=true
window-preview-title-position='TOP'
