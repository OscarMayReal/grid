// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model device {
    id String @id @default(cuid())
    type String @default("COMPUTER")
    name String @unique
    tenantId String
    addedBy String
    addedAt DateTime @default(now())
    assignedTo String?
    assignedAt DateTime?
    os String?
    osVersion String?
    architecture String?
    online Boolean @default(false)
    changedStatusAt DateTime @default(now())
    deviceGroupDevices deviceGroupDevice[]
    deviceToken String @unique @default(cuid())
    displayName String
}

model Policy {
    id String @id @default(cuid())
    name String
    description String?
    tenantId String
    addedBy String
    addedAt DateTime @default(now())
    assignedTo String?
    assignedAt DateTime?
    type String
    value String
    deviceGroupId String
    deviceGroup DeviceGroup @relation(fields: [deviceGroupId], references: [id])
}

model DeviceGroup {
    id String @id @default(cuid())
    name String @unique
    description String?
    tenantId String
    deviceGroupDevices deviceGroupDevice[]
    policies Policy[]
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())
    createdBy String
    displayName String
}

model deviceGroupDevice {
    id String @id @default(cuid())
    deviceGroupId String
    deviceId String
    device device @relation(fields: [deviceId], references: [id])
    deviceGroup DeviceGroup @relation(fields: [deviceGroupId], references: [id])
    @@unique([deviceGroupId, deviceId])
}
